{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ClubReportHub_Auth;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ClubReportHub",
    "Audience": "ClubReportHub.Client",
    "SigningKey": "dev-only-change-this-signing-key-with-at-least-32-characters",
    "ExpirationMinutes": 30
  },
  "Auth": {
    "EnableDevLogin": true
  },
  "GoogleAuthentication": {
    "ClientId": "",
    "AllowedHostedDomain": "fpt.edu.vn",
    "AllowedEmailDomains": "fpt.edu.vn, gmail.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://fptux-legacy-ui.pages.dev"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
