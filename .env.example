# ==============================================================================
# FPTU-Xperience - Environment Variables
# ==============================================================================

# Database (SQL Server 2022)
SQL_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Gateway Port (Exposed to Internet, default 7000 or change to 80)
GATEWAY_PORT=7000

# Allowed deployed frontend origin (scheme + hostname, no path or trailing slash)
FRONTEND_ORIGIN=https://fptux-legacy-ui.pages.dev
# Optional additional exact origins, separated by commas or semicolons.
CORS_ADDITIONAL_ORIGINS=

# Authentication & Security (Must be at least 32 characters).
# AuthService issues the token; Gateway and every downstream service, including
# AdminService, validate it with this same deployment-managed key.
JWT_SIGNING_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Google-only authentication. Create a Web OAuth client in Google Cloud and
# put its Client ID here (no client secret is used by this ID-token flow).
GOOGLE_CLIENT_ID=
# Optional Google Workspace domain, e.g. fpt.edu.vn. Leave blank to trust the DB allow-list only.
GOOGLE_ALLOWED_HOSTED_DOMAIN=
# Exact verified e-mail domains, comma-separated. Keep this set to fpt.edu.vn and gmail.com in production.
GOOGLE_ALLOWED_EMAIL_DOMAINS=fpt.edu.vn, gmail.com

# Use real, verified Google e-mails for the three teacher-test actors.
# The fallback @fpt.edu.vn values in the catalog are sample data only.
DEMO_ADMIN_EMAIL=replace-with-admin@your-domain.example
DEMO_ADMIN_FULL_NAME=Demo Administrator
DEMO_CLUB_MANAGER_EMAIL=replace-with-manager@your-domain.example
DEMO_STUDENT_EMAIL=replace-with-student@your-domain.example
DEMO_REFERENCE_DATE=2026-09-11
DEMO_DATA_RESET_ALL=false

# Redis Streams
REDIS_STREAM_NAME=clubreporthub-events
